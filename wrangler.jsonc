{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "codygriffith-com",
	// The worker emitted by @sveltejs/adapter-cloudflare.
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-09-30",
	// Required by SvelteKit for request-scoped AsyncLocalStorage.
	"compatibility_flags": ["nodejs_als"],
	"assets": {
		"binding": "ASSETS",
		// Same directory the adapter writes: static files, prerendered HTML and the worker.
		"directory": ".svelte-kit/cloudflare"
	}
}
